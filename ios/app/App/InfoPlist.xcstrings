{
  "sourceLanguage" : "en",
  "strings" : {
    "NSFaceIDUsageDescription" : {
      "comment" : "Privacy - Face ID Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Pinky asks for Face ID before it goes ahead with a step you approve."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "承認した操作を進める前に、Pinky は Face ID で確認します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在执行你批准的步骤前，Pinky 会先验证面容 ID。"
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription" : {
      "comment" : "Privacy - Local Network Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Pinky pairs with this iPhone and looks for its own pairing service to control your apps."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pinky はこの iPhone とペアリングし、アプリを操作するためにこの iPhone 自身のペアリングサービスを探します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pinky 需要与这台 iPhone 配对，并找到它自己的配对服务，才能操作你的 App。"
          }
        }
      }
    },
    "NSMicrophoneUsageDescription" : {
      "comment" : "Privacy - Microphone Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Pinky listens while you speak a task, after you tap the microphone."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マイクをタップすると、タスクを話している間 Pinky が聞き取ります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "轻点麦克风后，Pinky 会在你口述任务时收听。"
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription" : {
      "comment" : "Privacy - Speech Recognition Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Pinky turns what you say into the task you give it, on this iPhone when it can."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pinky は話した内容をタスクの文字にします。可能な場合はこの iPhone 上で処理します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pinky 会把你说的话转成任务文字，能在这台 iPhone 上完成时就在本机完成。"
          }
        }
      }
    }
  },
  "version" : "1.0"
